{
  "name": "ember",
  "version": "1.0.0",
  "private": true,
  "description": "Swipe. Match. Chat - then it disappears. A Tinder-style dating chat app with 24-hour ephemeral messages, media sharing and WebRTC video calls.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -n \"CSS,SRV\" -c \"magenta,cyan\" \"npm:dev:css\" \"npm:dev:server\"",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --watch",
    "dev:server": "node --watch server/server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --minify",
    "build": "npm run build:css",
    "start": "node server/server.js",
    "db:migrate": "node db/migrate.js",
    "db:ping": "node scripts/db-ping.mjs",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/migrate.js --fresh && node db/seed.js",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "lint": "eslint \"server/**/*.js\" \"public/js/**/*.js\" \"db/**/*.js\" \"scripts/**/*.mjs\"",
    "lint:fix": "eslint --fix \"server/**/*.js\" \"public/js/**/*.js\" \"db/**/*.js\" \"scripts/**/*.mjs\"",
    "test": "node scripts/dep-smoke.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "sweep": "node scripts/route-sweep.mjs",
    "test:browser": "node scripts/smoke-browser.js",
    "test:security": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.0",
    "file-type": "^22.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.11.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0",
    "@parcel/watcher": "2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/cli": "4.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.10.0",
    "globals": "^15.15.0",
    "js-yaml": "^4.3.2",
    "playwright": "^1.64.1",
    "socket.io-client": "^4.7.5",
    "tailwindcss": "4.3.0"
  }
}
