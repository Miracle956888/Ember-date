PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ephemeral_chat
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MESSAGE_TTL_HOURS=24
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
UPLOAD_DIR=./uploads
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --------------------------------------------------------------- deployment
# These are only needed when the app runs somewhere other than your laptop.
# See DEPLOY.md for a full host comparison and the exact commands.

# Behind a reverse proxy / PaaS (Caddy, nginx, Fly, Render) the app sees the
# proxy's address instead of the visitor's. Set to 1 so rate limiting, secure
# cookies and redirects work off X-Forwarded-* headers. Implied by NODE_ENV=production.
TRUST_PROXY=0
# Set to 1 when TLS terminates at that proxy: sends 301/308 upgrades to https://
# (leaves /api/health and /socket.io alone on purpose).
FORCE_HTTPS=0
# Any additional origins allowed by CORS, comma separated - e.g. a preview host
# or a second domain pointing at the same app.
EXTRA_ORIGINS=

# Optional DB tuning.
DB_POOL_SIZE=10
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# TLS to the database. Off is right for the bundled compose MySQL (private
# network) and for localhost. Turn it on for any managed MySQL: TiDB Cloud
# Serverless and Aiven both REFUSE a plaintext connection, and the error they
# return - "Connections using insecure transport are prohibited" - does not
# mention TLS configuration at all.
DB_SSL=false
# Provider CA bundle, e.g. the ca.pem you download from the TiDB/Aiven console.
# Setting this to a path that does not exist is a startup error on purpose.
# DB_SSL_CA=./secrets/tidb-ca.pem
# Only set this to false if the provider gives you no CA to verify against.
DB_SSL_REJECT_UNAUTHORIZED=true

# The 24-hour purge schedule (cron expression). Defaults to every 5 minutes.
CLEANUP_CRON=*/5 * * * *
LOG_LEVEL=info
