PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ephemeral_chat
JWT_ACCESS_SECRET=
# Also protects queued password-reset/verification payloads; keep stable or drain
# the delivery outbox before rotating this value.
JWT_REFRESH_SECRET=
MESSAGE_TTL_HOURS=24
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
UPLOAD_DIR=./uploads
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------------------------------------------------------- email / SMS
# SMTP is used for password-reset links and email verification codes.
# Use a transactional mail provider; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Replace with a sender address approved by your mail provider.
SMTP_FROM=Ember <no-reply@example.com>

# Phone verification uses Twilio's REST API. Leave blank to disable SMS in dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --------------------------------------------------------------- deployment
# These are only needed when the app runs somewhere other than your laptop.
# See DEPLOY.md for a full host comparison and the exact commands.

# Behind a reverse proxy / PaaS (Caddy, nginx, Fly, Render) the app sees the
# proxy's address instead of the visitor's. Set to 1 so rate limiting, secure
# cookies and redirects work off X-Forwarded-* headers. Implied by NODE_ENV=production.
TRUST_PROXY=0
# Set to 1 when TLS terminates at that proxy: sends 301/308 upgrades to https://
# (leaves /api/health and /socket.io alone on purpose).
FORCE_HTTPS=0
# Any additional origins allowed by CORS, comma separated - e.g. a preview host
# or a second domain pointing at the same app.
EXTRA_ORIGINS=

# Optional DB tuning.
DB_POOL_SIZE=10
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# TLS to the database. Off is right for the bundled compose MySQL (private
# network) and localhost. Turn it on for every managed/public MySQL connection.
DB_SSL=false
# For Aiven, download the service project CA PEM. Recommended for Render:
# base64-encode the whole PEM file and set DB_SSL_CA_BASE64 in the host's secret
# environment. For a local/container deployment, mount the PEM into the runtime
# and set DB_SSL_CA to its path (the file must exist inside that runtime).
# DB_SSL_CA_BASE64=
# DB_SSL_CA=./secrets/aiven-ca.pem
# Certificate-chain and hostname verification are always enabled with DB_SSL=true.
# DB_SSL_REJECT_UNAUTHORIZED=false is intentionally unsupported.

# The 24-hour purge schedule (cron expression). Defaults to every 5 minutes.
CLEANUP_CRON=*/5 * * * *
# Keep true with one continuously running app process. For cPanel host cron,
# set false and schedule `npm run job:cleanup` and `npm run job:delivery`.
RUN_BACKGROUND_JOBS=true
LOG_LEVEL=info
